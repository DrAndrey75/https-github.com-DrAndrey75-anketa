rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Catch-all Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email_verified == true || 
        request.auth.token.email == 'doctor.zhilyakov@gmail.com'
      ) && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'doctor.zhilyakov@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // --- Validation Blueprints ---
    function isValidSubmission(data) {
      return data.keys().hasAll(['scaleType', 'responses', 'score', 'createdAt', 'patientLastName', 'patientFirstName', 'patientMiddleName', 'patientPhone', 'status']) &&
             data.scaleType in ['VAS', 'CONSTANT', 'ASES', 'QUICKDASH', 'UCLA', 'WORC'] &&
             data.score is number &&
             data.responses is map &&
             data.patientLastName is string &&
             data.patientLastName.size() >= 1 &&
             data.patientFirstName is string &&
             data.patientFirstName.size() >= 1 &&
             // Using serverTimestamp() in App.tsx maps to request.time
             data.createdAt == request.time;
    }

    // --- Collection Rules ---

    // Admins Collection
    match /admins/{userId} {
      allow read: if isSignedIn();
      // Only existing admins can add new ones via console usually, or we can bootstrap the first one.
    }

    // Submissions Collection
    match /submissions/{submissionId} {
      // Patients can create submissions without being signed in (for the pre-visit flow)
      // but they MUST provide valid data.
      allow create: if isValidSubmission(incoming());
      
      // Only admins can read, update, or delete submissions
      allow get, list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Patients Collection (Optional for tracking)
    match /patients/{patientId} {
      allow create: if isValidId(patientId);
      allow read, write: if isAdmin();
    }
  }
}
