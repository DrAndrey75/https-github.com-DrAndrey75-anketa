# Email врача-администратора (Google-аккаунт).
# Только этот пользователь получит доступ к Панели врача.
VITE_ADMIN_EMAIL="admin@example.com"

# URL-префикс, по которому доступно приложение.
# Пример: /anketa-2025/ → сайт будет на http://109.195.99.28/anketa-2025/
# Должен начинаться и заканчиваться на /
VITE_BASE_PATH="/anketa-2025/"
