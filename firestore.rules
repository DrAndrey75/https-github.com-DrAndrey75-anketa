rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Запрещаем всё, что не описано явно
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Вспомогательные функции ─────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // Администратор — подтверждённый пользователь с записью в коллекции admins.
    // Первого администратора добавьте вручную через Firebase Console:
    //   Firestore → admins → Document ID = UID пользователя
    function isAdmin() {
      return isSignedIn()
          && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidSubmission(data) {
      return data.keys().hasAll([
               'scaleType', 'responses', 'score', 'createdAt',
               'patientLastName', 'patientFirstName', 'patientMiddleName',
               'patientPhone', 'status'
             ])
          && data.scaleType in ['VAS', 'CONSTANT', 'ASES', 'QUICKDASH', 'UCLA', 'WORC']
          && data.score is number
          && data.responses is map
          && data.patientLastName is string
          && data.patientLastName.size() >= 1
          && data.patientFirstName is string
          && data.patientFirstName.size() >= 1
          && data.createdAt == request.time;
    }

    // ── Коллекция admins ────────────────────────────────────────
    match /admins/{userId} {
      allow read: if isSignedIn();
      // Запись — только через Firebase Console
    }

    // ── Коллекция submissions ───────────────────────────────────
    match /submissions/{submissionId} {
      // Пациент заполняет анкету без авторизации
      allow create: if isValidSubmission(request.resource.data);

      // Только администратор читает, обновляет, удаляет
      allow get, list:    if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ── Коллекция patients (опционально) ────────────────────────
    match /patients/{patientId} {
      allow create: if patientId is string && patientId.size() <= 128;
      allow read, write: if isAdmin();
    }
  }
}
